# Copy to .env and fill in. Without DATABASE_URL the app uses data/db.json.
DATABASE_URL=mariadb://yehmee:PASSWORD@127.0.0.1:3306/yehmee

# Optional: runs the MariaDB tests against this (separate!) database; they empty it
TEST_DATABASE_URL=mariadb://yehmee:PASSWORD@127.0.0.1:3306/yehmee_test

# The site's public address, used in the links back from SumUp and PayPal.
# Without it the address of each request is used (fine locally).
# PUBLIC_URL=https://buchen.example.com

# SumUp: Visa/Mastercard deposits and online gift vouchers.
# SumUp dashboard → Developers → API keys (a sandbox merchant account works for testing).
# SUMUP_API_KEY=sup_sk_...
# SUMUP_MERCHANT_CODE=M...

# PayPal: developer.paypal.com → Apps & Credentials (Sandbox first, then Live).
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_ENV=sandbox            # "live" for real payments

# Without these keys a test checkout stands in (never in production, where the
# method is simply not offered). Nothing is charged by the test checkout.
